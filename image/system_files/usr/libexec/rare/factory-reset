#!/usr/bin/bash
# Rare OS factory reset, run at boot before the login (rare-factory-reset.service). Settings >
# System > Factory reset runs `os-admin factory-reset <mode>`, which leaves the mode in
# /var/lib/rare/factory-reset and restarts. This reads the mode and deletes the file first, so a
# crash or power cut never loops, then:
#   keep-games  signs out of Rare: Rare's settings, accounts, wallets, friends, notices and caches
#               go. Installed games, Steam (games and saves), ~/Games, emulators, ROMs, Wine
#               prefixes, web game data, screenshots and other files stay.
#   erase-all   every regular user's home is emptied and made again from /etc/skel.
# Both forget the Wi-Fi networks and the Bluetooth pairings.
# Never touches /usr, /boot, /sysroot or the ostree deployments, and in /etc only NetworkManager's
# saved connections. RARE_ROOT points it at a test tree (image/tests/factory-reset.sh).
set -uo pipefail
R="${RARE_ROOT:-}"
marker="$R/var/lib/rare/factory-reset"
log() { echo "rare-factory-reset: $*"; }

[[ -f "$marker" ]] || exit 0
mode="$(head -c 64 "$marker" | tr -dc 'a-z-')"
rm -f -- "$marker" "$marker.tmp"
sync
case "$mode" in
    keep-games | erase-all) ;;
    *)
        log "unknown mode '$mode', nothing done"
        exit 0
        ;;
esac
log "starting: $mode"

# Regular users (uid 1000..59999) and their homes, resolved under /var/home.
users() {
    if [[ -n "$R" ]]; then cat "$R/etc/passwd"; else getent passwd; fi |
        awk -F: '$3 >= 1000 && $3 < 60000 { print $1 ":" $3 ":" $4 ":" $6 }'
}

home_of() {
    local h="$1"
    [[ "$h" == /home/* ]] && h="/var$h"
    [[ "$h" =~ ^/var/home/[A-Za-z0-9._-]+$ ]] || return 1
    [[ -d "$R$h" && ! -L "$R$h" ]] || return 1
    printf '%s\n' "$R$h"
}

wipe() { rm -rf --one-file-system -- "$@"; }

keep_games() {
    local home="$1" d
    # Rare's own state. ~/.local/share/rare also holds game data (Wine prefixes, web game saves and
    # profiles), which stays.
    wipe "$home/.config/rare" "$home/.cache/rare" "$home/.local/state/rare" "$home/.local/state/rare-native" \
        "$home/.config/market.rare.launcher" "$home/.local/share/market.rare.launcher" "$home/.cache/market.rare.launcher"
    if [[ -d "$home/.local/share/rare" && ! -L "$home/.local/share/rare" ]]; then
        for d in "$home/.local/share/rare"/* "$home/.local/share/rare"/.[!.]*; do
            [[ -e "$d" || -L "$d" ]] || continue
            case "${d##*/}" in
                prefixes | webgames | chrome | games | saves) ;;
                *) wipe "$d" ;;
            esac
        done
    fi
}

erase_all() {
    local home="$1" uid="$2" gid="$3"
    find "$home" -mindepth 1 -maxdepth 1 -exec rm -rf --one-file-system -- {} +
    if [[ -d "$R/etc/skel" ]]; then cp -a "$R/etc/skel/." "$home/"; fi
    if [[ -z "$R" ]]; then
        chown -R "$uid:$gid" "$home"
        command -v restorecon >/dev/null && restorecon -R "$home"
    fi
    chmod 0700 "$home"
}

while IFS=: read -r name uid gid dir; do
    home="$(home_of "$dir")" || {
        log "skipped $name: home $dir is not under /var/home"
        continue
    }
    case "$mode" in
        keep-games) keep_games "$home" ;;
        erase-all) erase_all "$home" "$uid" "$gid" ;;
    esac
    log "$mode: done for $name"
done < <(users)

# Wi-Fi networks and other saved connections.
rm -f -- "$R/etc/NetworkManager/system-connections/"*
# Bluetooth pairings: the device folders (named by address) and the cache, per adapter.
for a in "$R/var/lib/bluetooth"/*/; do
    [[ -d "$a" ]] || continue
    for d in "$a"*; do
        case "${d##*/}" in
            [0-9A-F][0-9A-F]:* | cache) wipe "$d" ;;
        esac
    done
done
sync
log "finished: $mode"
exit 0
