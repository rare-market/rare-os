<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Rare OS</vendor>
  <vendor_url>https://rare.market</vendor_url>
  <action id="org.rare.imu.rate">
    <description>Change how often the motion sensor is read</description>
    <message>Authentication is required to change the motion sensor rate</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/rare/imu-rate</annotate>
  </action>
</policyconfig>
