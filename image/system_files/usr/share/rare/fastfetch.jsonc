{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "none" },
    "display": { "separator": "  " },
    "modules": [
        "title",
        "break",
        { "type": "os", "key": "OS", "format": "{pretty-name} {version}" },
        "host",
        "kernel",
        "uptime",
        "packages",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "battery"
    ]
}
